---
// src/components/Calendario.astro
// El calendario del mes del evento, con el día marcado en dorado.
//
// La grilla no está escrita a mano: sale de la fecha. Se calcula en qué
// día de la semana cae el 1 y cuántos días trae el mes, así que para
// otro evento alcanza con cambiar los tres datos de abajo y el
// calendario se rearma solo.
//
// Las medidas van en cqw —% del ancho de la columna— y no en
// breakpoints: se ve igual en el celular, en la tablet y en la
// computadora, como el resto de la invitación.

// ── DATOS EDITABLES ───────────────────────────────────────────
const anio = 2026;
const mes = 11; // 1 = enero … 11 = noviembre
const diaMarcado = 13;
const frase = "Reserva la fecha";
// ──────────────────────────────────────────────────────────────

const nombresMes = [
    "Enero",
    "Febrero",
    "Marzo",
    "Abril",
    "Mayo",
    "Junio",
    "Julio",
    "Agosto",
    "Septiembre",
    "Octubre",
    "Noviembre",
    "Diciembre",
];
const nombreMes = nombresMes[mes - 1];

// Las iniciales, empezando en domingo: así cae la columna del sábado al
// final, que es donde la busca la vista
const iniciales = ["D", "L", "M", "M", "J", "V", "S"];

// En qué columna arranca el 1 y cuántos días trae el mes
const arranque = new Date(anio, mes - 1, 1).getDay();
const diasDelMes = new Date(anio, mes, 0).getDate();

// Las casillas vacías del principio y después los días
const celdas: (number | null)[] = [
    ...Array(arranque).fill(null),
    ...Array.from({ length: diasDelMes }, (_, i) => i + 1),
];
---

<section id="calendario" class="seccion">
    <div id="ca-bloque" class="bloque">
        <!-- El ramo de flores, arriba del calendario -->
        <img
            class="ramo"
            src="/imagenes/centro.png"
            alt=""
            aria-hidden="true"
            width="380"
            height="197"
        />

        <p class="mes font-charm">{nombreMes} {anio}</p>

        <!-- La onda dorada -->
        <svg class="onda" viewBox="0 0 400 30" aria-hidden="true" focusable="false">
            <g stroke="#c0993f" stroke-width="1.5" fill="none" stroke-linecap="round">
                <path d="M26,15 C56,3 86,27 116,15 C140,5 160,10 172,15"></path>
                <path d="M374,15 C344,3 314,27 284,15 C260,5 240,10 228,15"></path>
            </g>
            <g fill="#c0993f">
                <path
                    d="M200,2 C201.5,10 205,13.5 213,15 C205,16.5 201.5,20 200,28 C198.5,20 195,16.5 187,15 C195,13.5 198.5,10 200,2 Z"
                ></path>
                <circle cx="178" cy="15" r="2.2"></circle>
                <circle cx="222" cy="15" r="2.2"></circle>
            </g>
        </svg>

        <!-- La grilla -->
        <div class="grilla">
            {iniciales.map((i) => <span class="inicial font-charm">{i}</span>)}
            {
                celdas.map((dia) =>
                    dia === null ? (
                        <span class="dia vacio" />
                    ) : dia === diaMarcado ? (
                        <span class="dia marcado font-charm">{dia}</span>
                    ) : (
                        <span class="dia font-charm">{dia}</span>
                    ),
                )
            }
        </div>

        <p class="frase font-charm">{frase}</p>
    </div>

    <!-- Una mariposa en el aire, a un costado -->
    <img
        class="mariposa"
        src="/imagenes/mariposa.png"
        alt=""
        aria-hidden="true"
        width="170"
        height="143"
    />
</section>

<style>
    /*
       container-type deja medir todo contra el ancho de la columna y no
       de la pantalla: 1cqw es el 1% de ese ancho.

       Sin fondo propio: se ve el bosque que pone el layout.
    */
    .seccion {
        position: relative;
        width: 100%;
        padding: 10cqw 0 12cqw;
        container-type: inline-size;
        background-color: transparent;
    }

    /*
       El calendario va sobre un papel apenas velado, con un hilo dorado
       de marco: así los números se leen sobre el bosque sin taparlo.

       El velo va como degradado y no como color: el modo oscuro forzado
       oscurece colores pero respeta las imágenes.
    */
    .bloque {
        position: relative;
        width: 78%;
        margin: 0 auto;
        padding: 6cqw 5cqw 7cqw;
        border: 1px solid #d8bd85;
        border-radius: 4cqw;
        background-image: linear-gradient(
            rgba(255, 255, 255, 0.82),
            rgba(255, 255, 255, 0.72)
        );
        text-align: center;
    }

    /* El ramo asoma por arriba del marco */
    .ramo {
        display: block;
        width: 58%;
        height: auto;
        margin: -14cqw auto 1cqw;
        user-select: none;
        -webkit-user-drag: none;
    }

    .mes {
        color: #c0993f;
        font-size: 8cqw;
        font-weight: 700;
        line-height: 1.1;
    }

    .onda {
        display: block;
        width: 72%;
        height: auto;
        margin: 1cqw auto 3cqw;
    }

    /* ── La grilla ──────────────────────────────────────────
       Siete columnas iguales: los números caen siempre debajo de su
       inicial, tenga el mes 28 días o 31. */
    .grilla {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 1.2cqw 0;
        align-items: center;
        justify-items: center;
    }

    .inicial {
        color: #c0993f;
        font-size: 4.6cqw;
        font-weight: 700;
        line-height: 1;
        padding-bottom: 1.6cqw;
    }

    .dia {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 7.4cqw;
        height: 7.4cqw;
        color: #2c3826;
        font-size: 4.4cqw;
        line-height: 1;
    }

    /*
       El día del evento: círculo dorado con el número en claro. El
       dorado va como degradado y no como color, por lo de siempre: el
       modo oscuro forzado respeta las imágenes.
    */
    .marcado {
        border-radius: 50%;
        background-image: linear-gradient(#d2a851, #bd8f36);
        color: #fffdf6;
        font-weight: 700;
        box-shadow: 0 0.3cqw 0.8cqw rgba(150, 110, 40, 0.35);
    }

    .frase {
        margin-top: 4cqw;
        color: #2c3826;
        font-size: 5cqw;
        font-variant-caps: small-caps;
        letter-spacing: 0.06em;
        line-height: 1;
    }

    /* ── La mariposa ────────────────────────────────────────
       En el aire, fuera del papel: no tapa nada. */
    .mariposa {
        position: absolute;
        right: 3%;
        bottom: 6%;
        width: 11%;
        height: auto;
        pointer-events: none;
        user-select: none;
        -webkit-user-drag: none;
    }

    @media (prefers-reduced-motion: no-preference) {
        .mariposa {
            animation: ca-volar 7.5s ease-in-out infinite;
        }
    }

    @keyframes ca-volar {
        0%,
        100% {
            transform: translate(0, 0) rotate(0deg);
        }
        50% {
            transform: translate(-1.4cqw, -2cqw) rotate(-7deg);
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("calendario");
        const bloque = document.getElementById("ca-bloque");
        if (!seccion || !bloque) return;

        // Sin animación si el visitante pidió menos movimiento: la
        // sección ya está armada y visible en el HTML.
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const renglones = Array.from(bloque.children);
        const marcado = bloque.querySelector(".marcado");
        const mariposa = seccion.querySelector(".mariposa");

        /*
           La entrada: todos los renglones arrancan al mismo tiempo pero
           cada uno viene de un lado distinto —el primero baja desde
           arriba y los demás entran alternando izquierda y derecha—, y
           además crecen un poquito. Así el armado se nota, que es la
           gracia, sin que la sección tarde en quedar lista.
        */
        gsap.set(renglones, {
            opacity: 0,
            x: (i) => (i === 0 ? "0%" : i % 2 === 1 ? "-14%" : "14%"),
            y: (i) => (i === 0 ? "-45%" : "0%"),
            scale: 0.92,
        });
        gsap.set(mariposa, { opacity: 0 });

        const linea = gsap.timeline({
            paused: true,
            defaults: { ease: "power2.out" },
        });

        linea
            .to(renglones, {
                    opacity: 1,
                    x: "0%",
                    y: "0%",
                    scale: 1,
                    duration: 1.2,
                    stagger: 0.09,
                    ease: "power3.out",
                })
            // el día del evento late una vez, para que salte a la vista
            .fromTo(
                marcado,
                { scale: 1 },
                { scale: 1.18, duration: 0.5, yoyo: true, repeat: 1 },
                0.9,
            )
            .to(mariposa, { opacity: 1, duration: 1.1 }, 0.8);

        ScrollTrigger.create({
            trigger: seccion,
            start: "top 80%",
            onEnter: () => linea.restart(),
            onLeaveBack: () => linea.pause(0),
        });
    });
</script>
