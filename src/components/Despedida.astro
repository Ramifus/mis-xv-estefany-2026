---
// src/components/Despedida.astro
// El cierre de la invitación: la frase de despedida, el botón para
// confirmar por WhatsApp y, alrededor, el bosque —la quinceañera, las
// flores, los hongos y las mariposas—.
//
// Acá no van iconos: solo el texto, el botón y los dibujos del bosque.
//
// Las medidas van en cqw —% del ancho de la columna— y no en
// breakpoints: se ve igual en el celular, en la tablet y en la
// computadora, como el resto de la invitación.

import { datosDelPase } from "../scripts/pase";

/*
   Cuántas personas entran con esta invitación. Lo manda la página:
   /pase3 da 3. El index no manda nada y queda en el pase general (2).
*/
export interface Props {
    pases?: number;
}
const { pases = 0 } = Astro.props;
const pase = datosDelPase(pases);

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "¡Te espero!";
const parrafos = [
    "Gracias por ser parte de este sueño que empieza entre luces y árboles.",
    "Tu presencia es el mejor regalo para esta noche que no voy a olvidar.",
];

// La confirmación, con el texto que mandó la clienta. La fecha va
// resaltada dentro del recuadro.
const tituloConfirmar = "Confirmación de asistencia";
const textoPlazo = "Agradecemos confirmar su asistencia hasta el";
const fechaPlazo = "1 de noviembre";
const textoPlazoFin = "para poder organizar y reservar los lugares correspondientes.";

// La tarjeta del pase
const encabezadoPase = "Pase personal";
const rotuloPase = "Válido para";

const textoBoton = "Confirmar asistencia";

// El WhatsApp al que llega la confirmación. Va sin +, sin espacios y sin
// guiones: así lo pide wa.me. 591 es Bolivia.
const whatsapp = "59176626843";

/*
   El mensaje con el que se abre el chat. El invitado solo aprieta enviar,
   y del otro lado llega siempre redactado igual.

   encodeURIComponent es imprescindible: sin él, los espaces, los acentos
   y los signos rompen el enlace y el mensaje llega cortado.
*/
const mensaje =
    "¡Hola! Confirmo mi asistencia a los XV años de Estefany, " +
    "el viernes 13 de noviembre. Ahí estaré sin falta. ¡Gracias por la invitación!";
const enlace = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensaje)}`;
// ──────────────────────────────────────────────────────────────
---

<section id="despedida" class="seccion">
    <!-- El bosque alrededor -->
    <img
        class="flores"
        src="/imagenes/floresizquieda.png"
        alt=""
        aria-hidden="true"
        width="599"
        height="639"
    />
    <img
        class="hongos"
        src="/imagenes/hongos.png"
        alt=""
        aria-hidden="true"
        width="440"
        height="501"
    />
    <img
        class="mariposa mariposa-izq"
        src="/imagenes/mariposa.png"
        alt=""
        aria-hidden="true"
        width="170"
        height="143"
    />
    <img
        class="mariposa mariposa-der"
        src="/imagenes/mariposa.png"
        alt=""
        aria-hidden="true"
        width="170"
        height="143"
    />

    <div id="de-bloque" class="bloque">
        <p class="titulo font-charm">{titulo}</p>

        <!-- La onda dorada -->
        <svg class="onda" viewBox="0 0 400 30" aria-hidden="true" focusable="false">
            <g stroke="#c0993f" stroke-width="1.5" fill="none" stroke-linecap="round">
                <path d="M26,15 C56,3 86,27 116,15 C140,5 160,10 172,15"></path>
                <path d="M374,15 C344,3 314,27 284,15 C260,5 240,10 228,15"></path>
            </g>
            <g fill="#c0993f">
                <path
                    d="M200,2 C201.5,10 205,13.5 213,15 C205,16.5 201.5,20 200,28 C198.5,20 195,16.5 187,15 C195,13.5 198.5,10 200,2 Z"
                ></path>
                <circle cx="178" cy="15" r="2.2"></circle>
                <circle cx="222" cy="15" r="2.2"></circle>
            </g>
        </svg>

        {parrafos.map((p) => <p class="parrafo font-charm">{p}</p>)}

        <p class="subtitulo font-charm">{tituloConfirmar}</p>

        <p class="parrafo plazo font-charm">
            {textoPlazo} <span class="fecha-plazo">{fechaPlazo}</span>, {textoPlazoFin}
        </p>

        <!-- El pase: tarjeta esmeralda con filete dorado y el número en
             un sello dorado -->
        <div class="pase" role="group" aria-label={`Pase válido para ${pase.texto}`}>
            <p class="pase-encabezado font-charm">
                <span class="pase-estrella" aria-hidden="true">✦</span>
                {encabezadoPase}
                <span class="pase-estrella" aria-hidden="true">✦</span>
            </p>

            <p class="pase-rotulo font-charm">{rotuloPase}</p>

            <div class="pase-sello">
                <span class="pase-numero font-charm">{pase.numero}</span>
            </div>

            <p class="pase-unidad font-charm">{pase.unidad}</p>
        </div>

        <a
            class="boton font-charm"
            href={enlace}
            target="_blank"
            rel="noopener noreferrer">{textoBoton}</a
        >
    </div>

    <!-- La quinceañera cierra la invitación, abajo -->
    <img
        id="de-quince"
        class="quince"
        src="/imagenes/quince.webp"
        alt="La quinceañera con su vestido verde"
        width="865"
        height="881"
    />
</section>

<style>
    /*
       container-type deja medir todo contra el ancho de la columna y no
       de la pantalla: 1cqw es el 1% de ese ancho.

       Sin fondo propio: se ve el bosque que pone el layout.
    */
    .seccion {
        position: relative;
        width: 100%;
        padding: 12cqw 0 0;
        overflow: hidden;
        container-type: inline-size;
        background-color: transparent;
    }

    .bloque {
        position: relative;
        z-index: 1;
        width: 80%;
        margin: 0 auto;
        text-align: center;
    }

    .titulo {
        color: #c0993f;
        font-size: 10cqw;
        font-weight: 700;
        line-height: 1.1;
    }

    .onda {
        display: block;
        width: 68%;
        height: auto;
        margin: 2.6cqw auto 4cqw;
    }

    .parrafo {
        color: #2c3826;
        font-size: 5.4cqw;
        line-height: 1.5;
    }

    /*
       El plazo para confirmar, la frase entera en un recuadro con el hilo
       dorado de la invitación. El velo va como degradado y no como
       color, por el modo oscuro.
    */
    .subtitulo {
        margin-top: 7cqw;
        color: #c0993f;
        font-size: 7cqw;
        font-weight: 700;
        line-height: 1.15;
    }

    .plazo {
        width: fit-content;
        max-width: 100%;
        margin: 3cqw auto 0;
        padding: 2.4cqw 4.5cqw;
        border: 1px solid #c0993f;
        border-radius: 2cqw;
        background-image: linear-gradient(
            rgba(255, 255, 255, 0.82),
            rgba(255, 255, 255, 0.72)
        );
    }

    /* La fecha, adentro, en semibold: Charm solo trae 400 y 700, así
       que cae en 700. Sin cortarse en dos renglones. */
    .fecha-plazo {
        font-weight: 600;
        white-space: nowrap;
    }

    .parrafo + .parrafo {
        margin-top: 2.4cqw;
    }

    /* ── La tarjeta del pase ────────────────────────────────
       Fondo esmeralda como el vestido, un filete dorado adentro y el
       número grande en un sello dorado. Compacta: el texto va pegado y
       el sello no ocupa más de lo necesario. Los fondos van como
       degradado, por el modo oscuro. */
    .pase {
        position: relative;
        width: 78%;
        margin: 5cqw auto 0;
        padding: 3.6cqw 5cqw 4cqw;
        border-radius: 3.6cqw;
        background-image:
            radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.14), transparent 60%),
            linear-gradient(160deg, #1f6b5c, #0e3a33);
        box-shadow: 0 0.8cqw 2cqw rgba(14, 58, 51, 0.35);
    }

    /* El filete dorado de adentro */
    .pase::before {
        content: "";
        position: absolute;
        inset: 1.3cqw;
        border: 1px solid rgba(214, 178, 96, 0.7);
        border-radius: 2.6cqw;
        pointer-events: none;
    }

    .pase-encabezado {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2cqw;
        color: #e2c06f;
        font-size: 4.4cqw;
        font-weight: 700;
        font-variant-caps: small-caps;
        letter-spacing: 0.08em;
        line-height: 1;
    }

    .pase-estrella {
        font-size: 2.8cqw;
        color: #d6b260;
    }

    .pase-rotulo {
        margin-top: 2cqw;
        color: #f3e2b4;
        font-size: 4.8cqw;
        line-height: 1.2;
    }

    /* El sello: un círculo dorado con brillo arriba y doble aro */
    .pase-sello {
        display: grid;
        place-items: center;
        width: 15cqw;
        height: 15cqw;
        margin: 2cqw auto 0;
        border-radius: 50%;
        background-image:
            radial-gradient(circle at 35% 28%, #f7e3a6, transparent 55%),
            linear-gradient(145deg, #e2c06f, #b48a34);
        box-shadow:
            0 0 0 0.9cqw rgba(214, 178, 96, 0.18),
            0 0 0 1.1cqw rgba(214, 178, 96, 0.55),
            0 0.6cqw 1.4cqw rgba(0, 0, 0, 0.3);
    }

    .pase-numero {
        color: #0e3a33;
        font-size: 9cqw;
        font-weight: 700;
        line-height: 1;
        transform: translateY(0.3cqw);
    }

    .pase-unidad {
        margin-top: 2.4cqw;
        color: #e2c06f;
        font-size: 6.4cqw;
        font-weight: 700;
        line-height: 1;
    }

    /* ── El botón ───────────────────────────────────────────
       Dorado sobre claro, con el hilo del mismo tono que los marcos. El
       fondo va como degradado y no como color: el modo oscuro forzado
       oscurece colores pero respeta las imágenes. */
    .boton {
        display: inline-block;
        margin-top: 6cqw;
        padding: 2.8cqw 8cqw;
        border: 1px solid #c0993f;
        border-radius: 999px;
        background-image: linear-gradient(#f6eddc, #efe1c6);
        color: #8a6a22;
        font-size: 5.4cqw;
        font-weight: 700;
        font-variant-caps: small-caps;
        letter-spacing: 0.06em;
        line-height: 1;
        text-decoration: none;
        box-shadow: 0 0.3cqw 0.9cqw rgba(150, 110, 40, 0.25);
    }

    /* ── La quinceañera ─────────────────────────────────────
       Cierra la invitación: va abajo, centrada y apoyada en el borde. */
    .quince {
        position: relative;
        z-index: 1;
        display: block;
        width: 72%;
        height: auto;
        margin: 4cqw auto 0;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* ── El bosque alrededor ────────────────────────────────── */
    .flores {
        position: absolute;
        left: -12%;
        bottom: -2%;
        width: 40%;
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
    }

    .hongos {
        position: absolute;
        right: -9%;
        bottom: -2%;
        width: 33%;
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* Las mariposas van en el aire, donde no tapan nada */
    .mariposa {
        position: absolute;
        width: 11%;
        height: auto;
        pointer-events: none;
        user-select: none;
        -webkit-user-drag: none;
    }

    .mariposa-izq {
        left: 4%;
        top: 8%;
        transform: scaleX(-1);
    }

    .mariposa-der {
        right: 4%;
        top: 30%;
    }

    @media (prefers-reduced-motion: no-preference) {
        .mariposa-izq {
            animation: dp-volar-izq 7s ease-in-out infinite;
        }

        .mariposa-der {
            animation: dp-volar-der 8.5s ease-in-out infinite;
        }
    }

    @keyframes dp-volar-izq {
        0%,
        100% {
            transform: scaleX(-1) translate(0, 0) rotate(0deg);
        }
        50% {
            transform: scaleX(-1) translate(1.4cqw, -2cqw) rotate(-7deg);
        }
    }

    @keyframes dp-volar-der {
        0%,
        100% {
            transform: translate(0, 0) rotate(0deg);
        }
        50% {
            transform: translate(-1.2cqw, -1.8cqw) rotate(6deg);
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("despedida");
        const bloque = document.getElementById("de-bloque");
        const quince = document.getElementById("de-quince");
        if (!seccion || !bloque) return;

        // Sin animación si el visitante pidió menos movimiento: la
        // sección ya está armada y visible en el HTML.
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const renglones = Array.from(bloque.children);
        const bosque = seccion.querySelectorAll(".flores, .hongos");
        const mariposas = seccion.querySelectorAll(".mariposa");

        /*
           A las mariposas solo se les toca la opacidad: su vuelo es una
           animación de CSS que usa transform, y si GSAP les tocara la
           posición, las dos se pisarían.
        */
        /*
           La entrada: todos los renglones arrancan al mismo tiempo pero
           cada uno viene de un lado distinto —el primero baja desde
           arriba y los demás entran alternando izquierda y derecha—, y
           además crecen un poquito. Así el armado se nota, que es la
           gracia, sin que la sección tarde en quedar lista.
        */
        gsap.set(renglones, {
            opacity: 0,
            x: (i) => (i === 0 ? "0%" : i % 2 === 1 ? "-14%" : "14%"),
            y: (i) => (i === 0 ? "-45%" : "0%"),
            scale: 0.92,
        });
        /*
           Las flores entran desde la izquierda y los hongos desde la
           derecha, los dos al mismo tiempo: el bosque se cierra alrededor
           de lo escrito.
        */
        gsap.set(bosque, {
            opacity: 0,
            x: (i) => (i === 0 ? "-16%" : i === 1 ? "16%" : "0%"),
            y: (i) => (i === 2 ? "-16%" : "0%"),
        });
        gsap.set(mariposas, { opacity: 0 });
        gsap.set(quince, { opacity: 0, y: 24 });

        const linea = gsap.timeline({
            paused: true,
            defaults: { ease: "power2.out" },
        });

        linea
            .to(bosque, { opacity: 1, x: "0%", y: "0%", duration: 1.4, stagger: 0.12, ease: "power3.out" })
            .to(
                renglones,
                {
                    opacity: 1,
                    x: "0%",
                    y: "0%",
                    scale: 1,
                    duration: 1.2,
                    stagger: 0.09,
                    ease: "power3.out",
                },
                0.2,
            )
            .to(quince, { opacity: 1, y: 0, duration: 1.4 }, 0.6)
            .to(mariposas, { opacity: 1, duration: 1.1, stagger: 0.3 }, 1);

        ScrollTrigger.create({
            trigger: seccion,
            start: "top 78%",
            onEnter: () => linea.restart(),
            onLeaveBack: () => linea.pause(0),
        });
    });
</script>
